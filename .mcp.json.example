{
  "mcpServers": {
    "docmost": {
      "serverUrl": "https://strand.perusahaanmu.com/mcp",
      "headers": {
        "Authorization": "Bearer <isi-token-docmost-jangan-di-commit>"
      }
    },
    "jira": {
      "serverUrl": "https://<your-subdomain>.atlassian.net",
      "email": "<user.email@company.com>",
      "apiToken": "<isi-atlassian-api-token-jangan-di-commit>",
      "headers": {
        "Authorization": "Basic <base64(email:apiToken)>"
      }
    }
  }
}
